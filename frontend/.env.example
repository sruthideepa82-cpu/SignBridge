# Copy to frontend/.env.local if the API is not reachable through the Vite proxy.
# Default "/api" works in development because Vite proxies it to the backend.
# Do not put secrets in frontend variables: anything prefixed with VITE_ ships to the browser.
VITE_API_BASE_URL=/api

# Optional. When both are set, Learn Signs progress is also saved to Supabase for signed-in users.
# Leave them empty to keep progress in this browser only. The anon key is public, so row level security
# on learn_progress must stay enabled (see supabase/migrations).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
