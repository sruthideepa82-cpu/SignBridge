# Copy this file to backend/.env and adjust values as needed.
# All settings use the SIGNBRIDGE_ prefix.

SIGNBRIDGE_ENVIRONMENT=development
SIGNBRIDGE_LOG_LEVEL=INFO

# JSON list of browser origins allowed to call the API directly.
SIGNBRIDGE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Webcam settings (OpenCV). Use 1, 2, ... if you have several cameras.
SIGNBRIDGE_CAMERA_INDEX=0
SIGNBRIDGE_CAMERA_WIDTH=640
SIGNBRIDGE_CAMERA_HEIGHT=480
SIGNBRIDGE_CAMERA_FPS=30
SIGNBRIDGE_CAMERA_JPEG_QUALITY=80
SIGNBRIDGE_CAMERA_MAX_READ_FAILURES=30

# MediaPipe hand landmark detection. The model file is downloaded by
# `python scripts/download_models.py` into backend/models/.
SIGNBRIDGE_HAND_DETECTION_ENABLED=true
SIGNBRIDGE_HAND_MAX_HANDS=2
SIGNBRIDGE_HAND_MIN_DETECTION_CONFIDENCE=0.5
SIGNBRIDGE_HAND_MIN_PRESENCE_CONFIDENCE=0.5
SIGNBRIDGE_HAND_MIN_TRACKING_CONFIDENCE=0.5
